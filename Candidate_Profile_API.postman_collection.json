    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string",
      "description": "Base URL for the API. Change to Supabase URL when deploying"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token - will be set automatically after login"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string",
      "description": "User ID - will be set automatically after login"
    },
    {
      "key": "educationId",
      "value": "",
      "type": "string",
      "description": "Education ID - will be set when adding education"
    },
    {
      "key": "experienceId",
      "value": "",
      "type": "string",
      "description": "Experience ID - will be set when adding experience"
    }
  ]
