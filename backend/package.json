{
    "name": "express-mongoose-boilerplate",
    "version": "1.0.0",
    "main": "index.js",
    "repository": "git@github.com:ichhoa129/express-mongoose-boilerplate.git",
    "author": "ichhoa <ichhoa129@gmail.com>",
    "license": "MIT",
    "scripts": {
        "prepare": "test -d node_modules/husky && husky install || echo \"husky is not installed\"",
        "test": "jest --runInBand",
        "lint": "eslint --fix --ext .js .",
        "lint:check": "eslint --ext .js .",
        "lint:staged": "lint-staged",
        "dev": "nodemon --exec npx babel-node src/core/bin/www.js",
        "start": "node ./dist/core/bin/www.js",
        "start:prod": "node ./dist/core/bin/www.js",
        "clean": "node scripts/clean.js",
        "build:babel": "babel ./src --out-dir dist --copy-files",
        "build": "npm run clean && npm run build:babel",
        "production:harness": "node scripts/production-harness.js",
        "knex": "babel-node node_modules/knex/bin/cli.js --knexfile src/core/config/knexfile.config.js",
        "db:migrate": "npm run knex -- migrate:latest",
        "db:rollback": "npm run knex -- migrate:rollback",
        "db:seed": "npm run knex -- seed:run",
        "db:reset": "npm run db:rollback && npm run db:migrate && npm run db:seed",
        "smoke": "node scripts/smoke-test.js"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@langchain/core": "^1.1.44",
        "@langchain/google-genai": "^2.1.30",
        "@langchain/langgraph": "^1.3.0",
        "@sentry/node": "^7.64.0",
        "axios": "^1.4.0",
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.10.0",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "debug": "^4.2.0",
        "dotenv": "^8.2.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "express": "^4.17.2",
        "express-rate-limit": "^6.11.2",
        "firebase-admin": "^13.10.0",
        "glob": "^7.2.0",
        "groq-sdk": "^1.1.2",
        "helmet": "^8.2.0",
        "http-status": "^1.5.0",
        "joi": "^17.4.2",
        "jsonwebtoken": "^9.0.3",
        "knex": "^2.5.1",
        "langchain": "^1.3.5",
        "lodash": "^4.17.21",
        "method-override": "^3.0.0",
        "mongoose": "^9.6.2",
        "morgan": "^1.10.1",
        "multer": "^2.1.1",
        "pg": "^8.7.1",
        "prettier": "^2.3.0",
        "redis": "^5.12.1",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^4.1.6",
        "winston": "^3.3.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@babel/cli": "^7.10.4",
        "@babel/core": "^7.10.4",
        "@babel/node": "^7.12.10",
        "@babel/plugin-proposal-class-properties": "^7.10.4",
        "@babel/plugin-proposal-decorators": "^7.12.1",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-async-to-generator": "^7.10.4",
        "@babel/plugin-transform-runtime": "^7.10.4",
        "@babel/preset-env": "^7.10.4",
        "@babel/register": "^7.10.5",
        "@babel/runtime": "^7.14.0",
        "@commitlint/cli": "^17.5.0",
        "@commitlint/config-conventional": "^17.4.4",
        "babel-eslint": "^10.1.0",
        "babel-jest": "^29.7.0",
        "babel-plugin-module-resolver": "^4.1.0",
        "babel-plugin-transform-runtime": "^6.23.0",
        "eslint": "^7.3.1",
        "eslint-config-airbnb-base": "^14.2.0",
        "eslint-plugin-import": "^2.21.2",
        "faker": "^5.5.3",
        "husky": "^8.0.3",
        "jest": "^29.7.0",
        "lint-staged": "^15.0.2",
        "nodemon": "^3.1.14"
    },
    "overrides": {
        "@langchain/langgraph": {
            "uuid": "^11.1.1"
        },
        "@langchain/langgraph-checkpoint": {
            "uuid": "^11.1.1"
        },
        "@langchain/langgraph-sdk": {
            "uuid": "^13.0.0"
        }
    }
}
