NODE_ENV=development

# Port config
PORT=3000

# Database
DATABASE_URL=mongodb://localhost/dbtest
MONGO_URL=mongodb://localhost:27017/dshiftify

#JWT config
JWT_SECRET=
EXPPIRE_DAYS=

#Hash password
SALT_ROUNDS=

#CORS_ALLOW=http://localhost:3000
CORS_ALLOW=*
HOST=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (AI session memory — TTL 30 min)
REDIS_URL=redis://localhost:6379
SESSION_TTL=1800

# ── AI / Gemini ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── STT — Groq Whisper v3 Turbo ───────────────────────────────────────────────
GROQ_API_KEY=

# ── TTS — Google Translate (no key needed, rate-limited) ─────────────────────
TTS_CHUNK_SIZE=200
# Optional: FPT AI TTS for higher quality Vietnamese voice (overrides Google Translate)
# Get key at: https://console.fpt.ai
FPT_AI_API_KEY=

# ── NLP — VnCoreNLP + PhoBERT ─────────────────────────────────────────────────
# docker run -p 9000:9000 vncorenlp/vncorenlp-server
VNCORENLP_URL=http://localhost:9000
PHOBERT_MODEL=vinai/phobert-base-v2

# ── Google Cloud (STT + TTS) ───────────────────────────────────────────────────
# Download service account JSON from Google Cloud Console → IAM → Service Accounts
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── pgvector — ensure extension installed in PostgreSQL ───────────────────────
# CREATE EXTENSION IF NOT EXISTS vector;
# Embedding model: text-embedding-004 (768 dims)

# ── Matching weights (per spec: skill 40%, exp 20%, AT 25%, geo 15%) ──────────
MATCH_SKILL_WEIGHT=0.40
MATCH_EXP_WEIGHT=0.20
MATCH_AT_WEIGHT=0.25
MATCH_GEO_WEIGHT=0.15
MATCH_TOP_K=3
MATCH_RADIUS_KM=10

# ── XAI ───────────────────────────────────────────────────────────────────────
# Score below this threshold triggers skill gap analysis
SKILL_GAP_THRESHOLD=70

# knexjs
DB_TYPE=pg
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=REDACTED
DB_NAME=boilerplate


# docker
# docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REDACTED
POSTGRES_DB=boilerplate

PGADMIN_DEFAULT_EMAIL=admin@gmail.com
PGADMIN_DEFAULT_PASSWORD=admin@gmail.com