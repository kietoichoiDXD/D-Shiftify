NODE_ENV=development

# Network
PORT=3000
HOST=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false

# PostgreSQL
DB_TYPE=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=boilerplate

# Optional 12-factor PostgreSQL connection string
DATABASE_URL=

# Supabase / PostgreSQL production
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional MongoDB for AI profile persistence
MONGO_URL=mongodb://localhost:27017/dshiftify

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
EXPIRE_DAYS=1d
REFRESH_EXPIRE_DAYS=7d

# Password hashing
SALT_ROUNDS=10

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
REDIS_URL=redis://localhost:6379
SESSION_TTL=1800

# AI
GEMINI_API_KEY=
GEMINI_ROUTER_MAX_OUTPUT_TOKENS=512
GEMINI_ANALYST_MAX_OUTPUT_TOKENS=768
GROQ_API_KEY=
FPT_AI_API_KEY=
TTS_CHUNK_SIZE=200
VNCORENLP_URL=http://localhost:9000
PHOBERT_MODEL=vinai/phobert-base-v2
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Matching
MATCH_SKILL_WEIGHT=0.40
MATCH_EXP_WEIGHT=0.20
MATCH_AT_WEIGHT=0.25
MATCH_GEO_WEIGHT=0.15
MATCH_TOP_K=3
MATCH_RADIUS_KM=10
MATCH_MIN_SCORE=40
AI_MATCH_MAX_RESULTS=20
AI_MATCH_MAX_CANDIDATES=60
AI_MATCH_DESCRIPTION_CHARS=320
AI_MATCH_USE_LLM_WEIGHTS=false
AI_MATCH_USE_LLM_EXPLANATIONS=false
AI_MATCH_XAI_LIMIT=3
SKILL_GAP_THRESHOLD=70
ALERT_SCORE_THRESHOLD=65

# Docker helpers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=boilerplate
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
